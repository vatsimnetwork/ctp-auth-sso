# App
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Empty for Dev. Set to .domain.com for sharing between subdomains
COOKIE_DOMAIN=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/ctpsso?sslmode=disable

# URL is switched based on APP_ENV 
VATSIM_CLIENT_ID=your_client_id_here
VATSIM_CLIENT_SECRET=your_client_secret_here
VATSIM_REDIRECT_URI=http://localhost:3000/auth/callback

# API Key for other services to validate 
# openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_random_secret

# Secret for signing OAuth state tokens
# openssl rand -hex 32
STATE_TOKEN_SECRET=your_state_token_secret_here

# Master admin CID this user always has the administrator role regardless of DB
ADMIN_CID=

# Allowlist for validate access, servces in the range still need internal api key 
# Example: INTERNAL_ALLOWLIST=127.0.0.1,10.0.*,192.168.1.0/24
INTERNAL_ALLOWLIST=127.0.0.1

# Trusted reverse proxy IPs/CIDRs
# Comma-separated. Fiber will trust PROXY_HEADER from these IPs only.
# Example: TRUSTED_PROXIES=10.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=

# Header to read the real client IP  when behind a trusted proxy
# Default: X-Forwarded-For
PROXY_HEADER=X-Forwarded-For

# Session settings
# IDLE_TIMEOUT_HOURS: session expires after this many hours of inactivity
# SESSION_LIFETIME_DAYS: absolute session expiry regardless of activity
IDLE_TIMEOUT_HOURS=4
SESSION_LIFETIME_DAYS=14

# Services shown on the landing page after login
# case-insensitive
SERVICES=route,slots,graphics

# For each key defined above, set NAME and URL:
SERVICE_ROUTE_NAME=Route
SERVICE_ROUTE_URL=http://localhost:3001
SERVICE_SLOTS_NAME=Slots
SERVICE_SLOTS_URL=http://localhost:3002
SERVICE_GRAPHICS_NAME=Graphics
SERVICE_GRAPHICS_URL=http://localhost:3003

# CTP API URL for pushing lock state (slot lock / route lock)
# Leave empty if not using the lock feature
CTP_API_URL=http://localhost:8080
